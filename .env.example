# Stripe secret key — get from Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Stripe webhook signing secret — get from Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# SSLCOMMERZ credentials — get from SSLCOMMERZ Merchant Panel
SSLCOMMERZ_STORE_ID=sslcz
SSLCOMMERZ_STORE_PASSWD=sslcz
SSLCOMMERZ_SANDBOX=true

# Public URL of your live site (for SSLCOMMERZ return URLs)
BASE_URL=https://your-domain.com

# Port the backend runs on
PORT=3000
